# My naming convention for saml2aws accounts:
#   - AWS_ACCOUNT_NAME[-IAM_ROLE_NAME]

# Fields for saml2aws accounts are defined (and *required* fields are validated) here:
# https://github.com/Versent/saml2aws/blob/master/pkg/cfg/cfg.go


### Default account (saml2aws login will prompt user to choose AWS account/role)

[default]
url                     = https://xxxxxxxxxx
username                = nick.fone@xxxxxxxxxx.com
#provider                = GoogleApps # broken, as at 2024-07-22
provider                = Browser # more reliabile and less convenient alternative (command-line flags: --idp-provider=Browser --download-browser-driver)
browser_type            = chrome # avoids downloading Chromium (command-line flag: --browser-type=chrome)
#browser_autofill        = true # throws an error which causes the browser window to be closed manually, as at 2024-07-29
mfa                     = Auto
skip_verify             = false
timeout                 = 0
aws_urn                 = urn:amazon:webservices
aws_session_duration    = 3600
aws_profile             = default
role_arn                =

