# My naming convention for aws profiles:
# COMPANY[--AWS_ACCOUNT_NAME[--IAM_ROLE_NAME]]

# Fields for aws profiles are documented here:
# https://docs.aws.amazon.com/cli/latest/userguide/cli-configure-files.html#cli-configure-files-settings


[default]
region = ap-southeast-2


