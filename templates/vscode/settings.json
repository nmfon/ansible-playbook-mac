{
    // CloudFormation Linter plugin
    // Path to the cfn-lint binary
    "cfnLint.path": "/usr/local/bin/cfn-lint",

    // Show changes to trailing whitespace
    "diffEditor.ignoreTrimWhitespace": false,

    // Show changes side-by-side
    "diffEditor.renderSideBySide": true,

    // Free up "Alt" key for column selection (hold it down)
    "editor.multiCursorModifier": "ctrlCmd",

    // Hide control characters
    "editor.renderControlCharacters": false,

    // Show whitespace
    "editor.renderWhitespace": "boundary",

    // Show vertical rulers to indicate common max line lengths
    "editor.rulers": [80, 100, 120],

    // Ignore Eclipse files (also generated by Checkstyle plugin)
    "files.exclude": {
        "**/.classpath": true,
        "**/.project": true,
        "**/.settings": true,
        "**/.factorypath": true
    },

    // Whether the proxy server certificate should be verified against the list of supplied CAs
    "http.proxyStrictSSL": false,

    // Checkstyle
    "java.checkstyle.version": "8.41",
    "java.checkstyle.configuration": "/google_checks.xml",

    // Automatically update java build config if it changes
    "java.configuration.updateBuildConfiguration": "automatic"

    // Set JAVA_HOME explicity, otherwise Language Support for Java extension fails to detect JAVA_HOME
    "java.home": "/usr/local/opt/openjdk/libexec/openjdk.jdk/Contents/Home",

    // Disable telemetry (for privacy)
    "telemetry.enableCrashReporter": false,
    "telemetry.enableTelemetry": false,

    // Zoom in a bit :)
    "window.zoomLevel": 1,

    // Render whitespace in red
    "workbench.colorCustomizations": {
        "editorWhitespace.foreground": "#990000"
    },

    // Disable stupid preview mode (i.e. always open files in a new tab)
    "workbench.editor.enablePreview": false,

    // Better icons for files and dirs
    "workbench.iconTheme": "material-icon-theme",

    // Red Hat YAML plugin
    // Allow CloudFormation keywords as valid YAML per:
    // https://github.com/redhat-developer/yaml-language-server/issues/77#issuecomment-511768680
    "yaml.customTags": [
        "!And scalar",
        "!And mapping",
        "!And sequence",
        "!If scalar",
        "!If mapping",
        "!If sequence",
        "!Not scalar",
        "!Not mapping",
        "!Not sequence",
        "!Equals scalar",
        "!Equals mapping",
        "!Equals sequence",
        "!Or scalar",
        "!Or mapping",
        "!Or sequence",
        "!FindInMap scalar",
        "!FindInMap mappping",
        "!FindInMap sequence",
        "!Base64 scalar",
        "!Base64 mapping",
        "!Base64 sequence",
        "!Cidr scalar",
        "!Cidr mapping",
        "!Cidr sequence",
        "!Ref scalar",
        "!Ref mapping",
        "!Ref sequence",
        "!Sub scalar",
        "!Sub mapping",
        "!Sub sequence",
        "!GetAtt scalar",
        "!GetAtt mapping",
        "!GetAtt sequence",
        "!GetAZs scalar",
        "!GetAZs mapping",
        "!GetAZs sequence",
        "!ImportValue scalar",
        "!ImportValue mapping",
        "!ImportValue sequence",
        "!Select scalar",
        "!Select mapping",
        "!Select sequence",
        "!Split scalar",
        "!Split mapping",
        "!Split sequence",
        "!Join scalar",
        "!Join mapping",
        "!Join sequence",
        "!And",
        "!If",
        "!Not",
        "!Equals",
        "!Or",
        "!FindInMap",
        "!Base64",
        "!Join",
        "!Cidr",
        "!Ref",
        "!Sub",
        "!GetAtt",
        "!GetAZs",
        "!ImportValue",
        "!Select",
        "!Split"
    ],

    // Red Hat YAML plugin
    // Enable/disable default YAML formatter (requires restart)
    "yaml.format.enable": true,

    // Red Hat YAML plugin
    // Enable/disable validation feature
    "yaml.validate": true
}
