# Functions #
#############

function docker() {
  case $* in
    images* )
      shift 1
      command docker images "$@" | head -1
      command docker images "$@" | tail +2 | sort
      ;;
    * )
      command docker "$@"
      ;;
  esac
}

function git() {
  case $* in
    push* )
      shift 1
      command git push -u "$@"
      ;;
    * )
      command git "$@"
      ;;
  esac
}

function git-refresh-local-workspaces() {
  for dir in $(ls -1); do
    echo "-----------------------------------------------------------"

    cd $dir
    echo "$dir"

    default_branch=$(git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@')
    echo "Default branch: $default_branch"

    git status
    git checkout "$default_branch"
    git pull

    cd ..
  done
}

function proxy-status() {
    echo http_proxy = $http_proxy
    echo HTTP_PROXY = $HTTP_PROXY

    echo https_proxy = $https_proxy
    echo HTTPS_PROXY = $HTTPS_PROXY

    echo no_proxy = $no_proxy
    echo NO_PROXY = $NO_PROXY
}

function proxy-enable() {
    export http_proxy=http://proxy.example.com.au:9090
    export HTTP_PROXY=${http_proxy}

    export https_proxy=http://proxy.example.com.au:9090
    export HTTPS_PROXY=${https_proxy}

    export no_proxy=localhost
    export NO_PROXY=${no_proxy}

    proxy-status
}

function proxy-disable() {
    unset http_proxy HTTP_PROXY
    unset https_proxy HTTPS_PROXY
    unset no_proxy NO_PROXY

    proxy-status
}


