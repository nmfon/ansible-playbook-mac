# Remove username@hostname from LPROMPT (when logged in as myself on localhost)
DEFAULT_USER=$USER

# Prevent "aws" plugin from displaying AWS profile name in RPROMPT,
# since it's already displayed in LPROMPT by "agnoster" theme.
#
# Currently, setting the following env var removes the AWS profile name
# from *both* the LPROMPT and the RPROMPT:
# https://github.com/ohmyzsh/ohmyzsh/tree/master/plugins/aws#plugin-options
# SHOW_AWS_PROMPT=false
#
# Workaround, override the aws_prompt_info function:
# https://github.com/ohmyzsh/ohmyzsh/tree/master/plugins/aws#theme
aws_prompt_info(){}

# Add newline (and $) to prompt
{% raw %}
prompt_end() {
  if [[ -n $CURRENT_BG ]]; then
    echo -n " %{%k%F{$CURRENT_BG}%}$SEGMENT_SEPARATOR"
  else
    echo -n "%{%k%}"
  fi
  #echo -n "%{%f%}"
  echo -n "%{%f%}\n$"
  CURRENT_BG=''
}
{% endraw %}


