alias git-versent='cd ~/repos/github/versent/'
alias git-vix='cd ~/repos/customers/vix/codecommit/'

# Workaround for the following ansible bug on Mac OS High Sierra (10.13):
# https://github.com/ansible/ansible/issues/32499
export OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES


# Functions
function docker() {
  case $* in
    images* )
      shift 1
      command docker images "$@" | head -1
      command docker images "$@" | tail +2 | sort
      ;;
    * )
      command docker "$@"
      ;;
  esac
}

fuction git() {
  case $* in
    push* )
      shift 1
      command git push -u "$@"
      ;;
    * )
      command git "$@"
      ;;
  esac
}

function tu-proxy-status() {
    echo http_proxy = $http_proxy
    echo HTTP_PROXY = $HTTP_PROXY

    echo https_proxy = $https_proxy
    echo HTTPS_PROXY = $HTTPS_PROXY

    echo no_proxy = $no_proxy
    echo NO_PROXY = $NO_PROXY
}

function tu-proxy-enable() {
    # Transurban on-prem HTTP proxy
    export http_proxy=http://proxy-au.transurban.com.au:9090
    export HTTP_PROXY=http://proxy-au.transurban.com.au:9090

    # Transurban on-prem HTTPS proxy
    export https_proxy=http://proxy-au.transurban.com.au:9090
    export HTTPS_PROXY=http://proxy-au.transurban.com.au:9090

    # Bypass proxy
    export no_proxy=localhost
    export NO_PROXY=localhost

    tu-proxy-status
}

function tu-proxy-disable() {
    unset http_proxy HTTP_PROXY
    unset https_proxy HTTPS_PROXY
    unset no_proxy NO_PROXY

    tu-proxy-status
}
