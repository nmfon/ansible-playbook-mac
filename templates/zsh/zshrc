# My customisations


# Source bash profile (only for configuration added by installers)
source $HOME/.bash_profile


# Remove username@hostname from prompt (when logged in as myself on localhost)
DEFAULT_USER=$USER


# Java home
export JAVA_HOME=/usr/local/opt/openjdk

# Groovy home
export GROOVY_HOME=/usr/local/opt/groovy/libexec


# Java bin path
export PATH="$JAVA_HOME/bin:$PATH"

# Go path
export GOPATH="$HOME/go"
export PATH="$GOPATH/bin:$PATH"

# MacPorts bin path
export PATH="/opt/local/bin:/opt/local/sbin:$PATH"

# Python site packages path
export PATH="$HOME/Library/Python/3.9/bin:$PATH"

# Sonar bin path
export PATH="/opt/sonar-scanner-3.2.0.1227-macosx/bin:$PATH"

# Visual Studio Code path
export PATH="/Applications/Visual Studio Code.app/Contents/Resources/app/bin:$PATH"


# My bin path
export PATH="$HOME/bin:$PATH"

# AWS Login for Mercer
#[ -f $HOME/bin/mercer-aws-login.sh ] && . $HOME/bin/mercer-aws-login.sh


# Aliases
